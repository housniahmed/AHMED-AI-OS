POSTGRES_DB=ahmed_ai_os
POSTGRES_USER=ahmed
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ahmed:change-me@postgres:5432/ahmed_ai_os
AHMED_AI_OS_ENV=development

# B37 - external model provider (leave empty for provider-free development)
MODEL_PROVIDER_NAME=openai-compatible
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODEL=
MODEL_PROVIDER_TIMEOUT_SECONDS=30

