POSTGRES_DB=ahmed_ai_os
POSTGRES_USER=ahmed
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ahmed:change-me@postgres:5432/ahmed_ai_os
AHMED_AI_OS_ENV=development

# B37 - external model provider (leave empty for provider-free development)
MODEL_PROVIDER_NAME=openai-compatible
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODEL=
MODEL_PROVIDER_TIMEOUT_SECONDS=30

# B38 - optional multi-provider runtime
# MODEL_PROVIDER_IDS=primary,backup
# MODEL_PROVIDER_PRIMARY_NAME=primary
# MODEL_PROVIDER_PRIMARY_BASE_URL=
# MODEL_PROVIDER_PRIMARY_API_KEY=
# MODEL_PROVIDER_PRIMARY_MODEL=
# MODEL_PROVIDER_PRIMARY_PRIORITY=100
# MODEL_PROVIDER_PRIMARY_TASKS=chat,reasoning
# MODEL_PROVIDER_BACKUP_NAME=backup
# MODEL_PROVIDER_BACKUP_BASE_URL=
# MODEL_PROVIDER_BACKUP_API_KEY=
# MODEL_PROVIDER_BACKUP_MODEL=
# MODEL_PROVIDER_BACKUP_PRIORITY=50
# MODEL_PROVIDER_BACKUP_TASKS=chat,reasoning

# B39 - reliability defaults
MODEL_RETRY_MAX_ATTEMPTS=2
MODEL_RETRY_BACKOFF_SECONDS=0.25
MODEL_RETRY_MAX_BACKOFF_SECONDS=5
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_SECONDS=30
MODEL_HEALTH_STORE_PATH=./data/model-health.json

# B40 - model usage and cost intelligence
# Usage is persisted when this path is configured.
MODEL_USAGE_STORE_PATH=./data/model-usage.json
# Optional vendor-neutral pricing catalog. Leave empty to report usage/tokens/latency
# without estimating monetary cost.
# Example:
# MODEL_PRICING_JSON=[{"provider":"primary","model":"model-name","input_per_1m_tokens":1.0,"output_per_1m_tokens":2.0}]

# B41 - adaptive model routing
# Default preserves B38 priority routing. Set to adaptive to use B39/B40 metrics.
MODEL_ROUTING_MODE=priority
MODEL_ROUTING_RELIABILITY_WEIGHT=0.35
MODEL_ROUTING_LATENCY_WEIGHT=0.25
MODEL_ROUTING_QUALITY_WEIGHT=0.25
MODEL_ROUTING_COST_WEIGHT=0.15
# Optional hard constraints for adaptive mode
# MODEL_ROUTING_MIN_RELIABILITY=0.95
# MODEL_ROUTING_MAX_LATENCY_MS=1500
# MODEL_ROUTING_MAX_COST_USD_PER_ATTEMPT=0.01
MODEL_ROUTING_DEFAULT_QUALITY=0.5
MODEL_ROUTING_UNKNOWN_COST_SCORE=0.5

MODEL_ROUTING_LATENCY_SCORE_SCALE_MS=1000
MODEL_ROUTING_COST_SCORE_SCALE_USD=0.01

# B42 - evaluation feedback and learned model quality
# Optional durable learned quality profiles for B41.
MODEL_QUALITY_STORE_PATH=./data/model-quality.json
MODEL_QUALITY_ALPHA=0.25
MODEL_QUALITY_PRIOR_SCORE=0.5
MODEL_QUALITY_CONFIDENCE_FULL_AT=5
